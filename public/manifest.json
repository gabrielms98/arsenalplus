{
  "manifest_version": 3,
  "name": "Arsenal+",
  "version": "0.5.1",
  "description": "Melhorias para arsenalsports.com: preços ocultos, filtros de catálogo por tipo de produto e peça, filtros de preço, e alerta de volta ao estoque.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arsenal+"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://www.arsenalsports.com/*",
    "https://arsenalsports.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.arsenalsports.com/*",
        "https://arsenalsports.com/*"
      ],
      "js": [
        "common.js",
        "content-product.js",
        "content-listing.js",
        "content-presets.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
