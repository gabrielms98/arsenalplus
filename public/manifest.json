{
  "manifest_version": 3,
  "name": "Arsenal+",
  "version": "0.2.0",
  "description": "Melhorias para arsenalsports.com: mostra o preço de produtos mesmo quando ele não aparece na página.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arsenal+"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.arsenalsports.com/*",
        "https://arsenalsports.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
